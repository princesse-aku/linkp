# =====================================================================
# LinkP : variables d'environnement
# Copie ce fichier en .env puis remplis les valeurs. Ne commite jamais .env.
# Les valeurs par défaut fonctionnent en local avec les émulateurs.
# =====================================================================

# ---------- Général ----------
ENV=development
FRONTEND_ORIGIN=http://localhost:3000
BACKEND_PUBLIC_URL=http://localhost:8000
# Clé qui signe l'état OAuth Google. En production : une longue valeur aléatoire.
SECRET_KEY=dev-secret-change-me-dev-secret-change-me
# Chiffre les clés RodiumAI des utilisateurs. Obligatoire en production, facultatif en dev.
# Générer : python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Attention : la perdre ou la changer oblige chaque utilisateur à ressaisir sa clé.
ENCRYPTION_KEY=
# URL de l'API vue depuis le navigateur
NEXT_PUBLIC_API_URL=http://localhost:8000
# Adresse publique du site : sert au SEO (liens canoniques, plan du site, image de partage).
# Production : https://ton-domaine.com (sans « / » final)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- Firebase (Auth + Firestore) ----------
# Dev : un projet "demo-" fonctionne sans compte avec les émulateurs.
FIREBASE_PROJECT_ID=demo-linkp
# Production uniquement : contenu JSON du compte de service (ou chemin du fichier)
FIREBASE_SERVICE_ACCOUNT_JSON=
# Config web Firebase (console Firebase > Paramètres du projet > Vos applications)
NEXT_PUBLIC_FIREBASE_API_KEY=fake-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=localhost
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-linkp
NEXT_PUBLIC_FIREBASE_APP_ID=
# Dev : adresse de l'émulateur Auth vue depuis le navigateur. Production : laisser vide.
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_URL=http://localhost:9099

# ---------- Emails ----------
# Dev : "smtp" vers Mailpit (docker compose le configure, boîte sur http://localhost:8025).
#       Pour Mailtrap : EMAIL_PROVIDER=smtp + SMTP_HOST/PORT/USER/PASSWORD de Mailtrap.
# Production : "resend".
EMAIL_PROVIDER=smtp
EMAIL_FROM=LinkP <no-reply@linkp.local>
RESEND_API_KEY=
# Uniquement pour un SMTP externe (le compose force Mailpit en local)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=false

# ---------- RodiumAI ----------
# Chaque utilisateur renseigne SA clé dans l'application (onboarding, puis profil) : elle est vérifiée
# puis stockée chiffrée. Le serveur n'a donc aucune clé RodiumAI.
RODIUM_API_URL=https://api.rodiumai.io/v1
RODIUM_MODEL=google/gemini-3.8-flash
# Modèle qui génère les images des posts (envoyées ensuite sur Cloudinary)
RODIUM_IMAGE_MODEL=google/gemini-3.1-flash-lite-image
# Facultatif : ta clé personnelle, uniquement pour le script qui liste les modèles
#   docker compose run --rm backend python -m app.scripts.list_models gemini
RODIUM_API_KEY=

# ---------- Google Agenda (Google Cloud Console) ----------
# Identifiants OAuth "Application Web". URI de redirection autorisée :
#   {BACKEND_PUBLIC_URL}/api/calendar/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- Cloudinary ----------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=linkp
MAX_UPLOAD_MB=10
