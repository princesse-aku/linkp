# Variables d'environnement de PRODUCTION de l'API LinkP (FastAPI Cloud).
# Ce fichier sert de liste : aucune vraie valeur ici. Les valeurs se definissent avec
#   fastapi cloud env set NOM "valeur"      (ajouter --secret pour les valeurs sensibles)
# ou avec le script  backend/scripts/push-prod-env.ps1  qui lit un fichier local non commite.

ENV=production
# Adresse du site (CORS et redirections). Doit correspondre exactement a l'origine du frontend.
FRONTEND_ORIGIN=https://TON-SITE
# Adresse publique de l'API, donnee par FastAPI Cloud (ou ton domaine personnalise).
BACKEND_PUBLIC_URL=https://TON-API
# Longues valeurs aleatoires. ENCRYPTION_KEY : python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=
ENCRYPTION_KEY=

# Firebase : projet link-p27, compte de service (contenu JSON complet, en secret)
FIREBASE_PROJECT_ID=link-p27
FIREBASE_SERVICE_ACCOUNT_JSON=

# Emails (Resend) : domaine alaprincesse.com verifie dans Resend
EMAIL_PROVIDER=resend
EMAIL_FROM=LinkP <hello@alaprincesse.com>
RESEND_API_KEY=

# Google Agenda : redirect URI a autoriser = {BACKEND_PUBLIC_URL}/api/calendar/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=linkp
MAX_UPLOAD_MB=10

# RodiumAI (chaque utilisateur apporte sa cle)
RODIUM_API_URL=https://api.rodiumai.io/v1
RODIUM_MODEL=google/gemini-3.8-flash
