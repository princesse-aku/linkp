rules_version = '2';

// Toutes les données passent par l'API FastAPI (Firebase Admin, qui ignore ces règles).
// Aucun accès direct n'est donc autorisé depuis les navigateurs.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
